<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000D1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="التعريف بالمنظومة"
        android:textColor="#00FFFF"
        android:gravity="center"
        android:textSize="22sp"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:padding="20dp"
        android:text="هنا يمكنك وضع وصف المنظومة، أهدافها، وقدراتها بشكل تعريفي."
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#08111F"
        android:weightSum="4">

        <Button
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الرئيسية"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />

        <Button
            android:id="@+id/btn_radar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الرادار"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="التعريف"
            android:textSize="10sp"
            android:backgroundTint="#00B7D6"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الإعدادات"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />
    </LinearLayout>

</RelativeLayout>
