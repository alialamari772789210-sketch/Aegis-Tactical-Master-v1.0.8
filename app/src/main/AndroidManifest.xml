<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.jamesfirstok.aegis">

    <!-- صلاحيات الرادار التكتيكي والارتباط اللاسلكي العميق -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- الوصول لبيانات الأقمار الصناعية الخام (Raw GNSS) -->
    <uses-permission android:name="android.permission.LOCATION_HARDWARE" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <!-- عمليات الراديو والتشويش والتحليل الطيفي (SDR) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- صلاحيات السيطرة على العتاد والتحييد الدفاعي -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" /> <!-- لتحويل المكبرات لمصدر موجات فوق صوتية -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- صلاحيات متقدمة للعمل المستقل (تتطلب Root في بعض العمليات) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".AegisApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Aegis Tactical Master"
        android:theme="@style/Theme.Aegis"
        android:requestLegacyExternalStorage="true">

        <!-- الخدمة العملياتية المستقلة (تعمل في الخلفية دائماً) -->
        <service
            android:name=".service.AegisService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|dataSync|connectedDevice" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aegis.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- مستقبل الأوامر التكتيكية عند بدء التشغيل -->
        <receiver android:name=".service.AlertManager" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
