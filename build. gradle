// ============================================
// AEGIS TACTICAL PROJECT - ROOT BUILD FILE
// الملف الجذري الرئيسي للمشروع
// ============================================

plugins {
    id 'com.android.application' version '8.1.1' apply false
    id 'org.jetbrains.kotlin.android' version '1.9.10' apply false
}

// ============================================
// المستودعات المركزية للمشروع
// ============================================

allprojects {
    repositories {
        google()
        mavenCentral()

        // مستودع JitPack لدعم المكتبات الخارجية
        maven { url 'https://jitpack.io' }
    }
}

// ============================================
// مهمة تنظيف المشروع
// ============================================

tasks.register('clean', Delete) {
    delete rootProject.buildDir
}
