<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000D1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ SOVEREIGN COMMAND | قيادة"
            android:textColor="#00FFFF"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- زر الرادار -->
        <Button
            android:id="@+id/btn_radar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#001A33"
            android:text="📡 RADAR SYSTEM"
            android:textColor="#00FFFF" />

        <!-- زر السايبر -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#001A33"
            android:text="🛡️ CYBER DEFENSE"
            android:textColor="#00FFFF" />

    </LinearLayout>
</ScrollView>
