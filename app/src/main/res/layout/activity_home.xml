<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000D1A">

    <TextView
        android:id="@+id/home_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SOVEREIGN COMMAND | القيادة"
        android:textColor="#00FFFF"
        android:gravity="center"
        android:padding="20dp"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/home_title"
        android:layout_margin="20dp"
        android:padding="16dp"
        android:text="هذه هي الصفحة الرئيسية"
        android:textColor="#FFFFFF"
        android:background="#08111F"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#08111F"
        android:weightSum="4">

        <Button
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الرئيسية"
            android:textSize="10sp"
            android:backgroundTint="#00B7D6"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_radar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الرادار"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="التعريف"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="الإعدادات"
            android:textSize="10sp"
            android:backgroundTint="#001A33"
            android:textColor="#00FFFF" />
    </LinearLayout>

</RelativeLayout>
