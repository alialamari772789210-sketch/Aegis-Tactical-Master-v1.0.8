name: Aegis Sovereign - Unified Strategic Pipeline

on:
  push:
    branches: [ "main", "master" ]
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:

jobs:
  operational_sync_and_build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      
    steps:
      # 1. سحب الكود (استخدام v4 المستقرة التي نجحت في المزامنة)
      - name: Checkout Code
        uses: actions/checkout@v4

      # 2. تنفيذ بروتوكول المزامنة الحركية
      - name: Execute Protocol Sync
        run: |
          if [ -f "./sync.sh" ]; then
            chmod +x ./sync.sh
            ./sync.sh
          else
            echo "Notice: sync.sh not found, skipping sync protocol."
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # 3. تجهيز البيئة البرمجية (JDK 17) بالنسخة v4 المستقرة
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      # 4. منح صلاحيات المحرك
      - name: Grant execute permission for gradlew
        run: chmod +x gradlew || true

      # 5. تصنيع النسخة النهائية APK
      - name: Build with Gradle
        run: ./gradlew assembleRelease

      # 6. رفع النسخة إلى قسم الإصدارات بالنسخة v1 المستقرة
      - name: Upload Secure APK Release
        uses: softprops/action-gh-release@v1
        with:
          files: app/build/outputs/apk/release/*.apk
          tag_name: v1.0.8-Release
          name: Aegis Tactical v1.0.8-Release (Sovereign Node)
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
