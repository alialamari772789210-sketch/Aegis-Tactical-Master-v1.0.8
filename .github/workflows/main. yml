name: Aegis Sovereign - Unified Strategic Pipeline

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  operational_sync_and_build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew || true

      # بناء التطبيق
      - name: Build APK
        run: ./gradlew assembleDebug

      # تحديد مسار الملف بدقة
      - name: Locate APK
        id: locate_apk
        run: |
          APK_PATH=$(find . -name "*.apk" -not -path "*/build-cache/*" | head -n 1)
          echo "apk_path=$APK_PATH" >> $GITHUB_OUTPUT
          echo "Found: $APK_PATH"

      # رفع الملف لقسم الإصدارات (باسم ثابت ليعمل الرابط)
      - name: Upload to Release
        uses: softprops/action-gh-release@v1
        with:
          files: ${{ steps.locate_apk.outputs.apk_path }}
          tag_name: v1.0.8-Master
          name: Aegis Tactical v1.0.8 "Voice Master"
          body: "Auto-build for version 1.0.8-Master"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # --- الخطوة الجديدة: ربط الرابط في الصفحة الرئيسية بالملف المرفوع ---
      - name: Update README Download Link
        run: |
          # هذا السطر سيقوم بتحديث الرابط في ملف README ليوجه المستخدم إلى ملف الـ APK المرفوع في الـ Releases
          RELEASE_URL="https://github.com{{ github.repository }}/releases/download/v1.0.8-Master/$(basename ${{ steps.locate_apk.outputs.apk_path }})"
          sed -i "s|🚀 Download Aegis_Tactical_v1.0.8M.apk|🚀 [Download Aegis_Tactical_v1.0.8M.apk]($RELEASE_URL)|g" README.md
          
          git config --global user.name "Ali Al_amari [Bot]"
          git config --global user.email "aliamari@bot.com"
          git add README.md
          git commit -m "Update download link in README for v1.0.8-Master" || echo "No changes to commit"
          git push
