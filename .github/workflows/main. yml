name: Aegis Sovereign - Unified Strategic Pipeline

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  operational_sync_and_build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew || true

      # 1. بناء التطبيق (سيستغرق وقتاً لأنه سيبحث عن كافة المكتبات)
      - name: Build APK
        run: ./gradlew assembleDebug --stacktrace

      # 2. تحديد مسار الملف بدقة (رادار البحث الشامل)
      - name: Locate APK
        id: locate_apk
        run: |
          # البحث عن أي ملف APK ناتج عن عملية البناء
          APK_FILE=$(find . -name "*.apk" -not -path "*/build-cache/*" | head -n 1)
          if [ -z "$APK_FILE" ]; then
            echo "Error: APK not found!"
            exit 1
          fi
          echo "apk_path=$APK_FILE" >> $GITHUB_OUTPUT
          echo "apk_name=$(basename $APK_FILE)" >> $GITHUB_OUTPUT

      # 3. حفظ الملف في "القطع الأثرية" (Artifacts) لكي يظهر في الصفحة التي صورتها
      - name: Save to Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: Aegis_Tactical_v1.0.8M_Internal
          path: ${{ steps.locate_apk.outputs.apk_path }}

      # 4. رفع الملف لقسم الإصدارات (Releases) لإنشاء الرابط الدائم
      - name: Upload to Release
        uses: softprops/action-gh-release@v1
        with:
          files: ${{ steps.locate_apk.outputs.apk_path }}
          tag_name: v1.0.8-Release
          name: Aegis Tactical v1.0.8 "Voice Master"
          body: "Verification Hash: c892e8a1-ff82-416b-a23d-004a4b4f5353"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # 5. تحديث رابط التحميل في ملف README (الواجهة الرئيسية)
      - name: Link APK in README
        run: |
          # الرابط المباشر للملف بعد الرفع
          DOWNLOAD_URL="https://github.com{{ github.repository }}/releases/download/v1.0.8-Release/${{ steps.locate_apk.outputs.apk_name }}"
          
          # استبدال النص العادي برابط تشعبي في README
          sed -i "s|🚀 Download Aegis_Tactical_v1.0.8M.apk|🚀 [Download Aegis_Tactical_v1.0.8M.apk]($DOWNLOAD_URL)|g" README.md
          
          # حفظ التعديلات في المستودع
          git config --global user.name "Aegis-Build-Bot"
          git config --global user.email "bot@aegis.tactical"
          git add README.md
          git commit -m "chore: link APK v1.0.8 to README [skip ci]" || echo "No changes"
          git push
